# Скопируйте в .env и при необходимости измените значения.
# Все переменные имеют значения по умолчанию в docker-compose.yml,
# поэтому .env нужен только для переопределения.

# --- PostgreSQL ---
POSTGRES_USER=culturalfind
POSTGRES_PASSWORD=culturalfind
POSTGRES_DB=culturalfind
POSTGRES_PORT=5432

# --- Порты хоста ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- AI (локальный Ollama) ---
# изнутри контейнера хост доступен как host.docker.internal
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
AI_ENABLED=true
# агент с function calling (многошаговые вопросы: «самый старый музей и что
# рядом»); при сбое тихо откатывается на обычный разбор
AI_AGENT_ENABLED=true

# --- Ограничения безопасности (§42) ---
MAX_RADIUS_METERS=10000
MAX_LIMIT=100

# --- Веса гибридного скоринга рекомендаций (§28) ---
SCORE_WEIGHT_SEMANTIC=0.5
SCORE_WEIGHT_SPATIAL=0.3
SCORE_WEIGHT_CATEGORY=0.2

# --- Прочее ---
LOG_LEVEL=INFO
# Внешний геокодер (§26) по умолчанию выключен — разрешение мест по своей БД
GEOCODER_URL=
# Тайлы карты (OpenStreetMap)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
